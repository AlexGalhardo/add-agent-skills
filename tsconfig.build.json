{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "types": ["node"],
        "noEmit": false,
        "declaration": true,
        "isolatedDeclarations": true,
        "emitDeclarationOnly": true,
        "rewriteRelativeImportExtensions": true,
        "rootDir": "src",
        "outDir": "dist"
    },
    "include": ["src"],
    "exclude": ["src/bin.ts"]
}
